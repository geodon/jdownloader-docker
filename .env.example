# JDownloader Docker Configuration

# MyJDownloader credentials (required)
MYJD_EMAIL=user@example.com
MYJD_PASSWORD=your_password_here
MYJD_DEVICENAME=JDownloader-Docker

# Archive extraction behavior
# Optional: set the default automatic extraction behavior to true or false.
# Leave unset to preserve the existing JDownloader setting.
# AUTO_EXTRACTION_ENABLED=false
# false: delete archive files after extraction (default)
# true: keep archive files
DISABLE_ARCHIVE_DELETE=false

# Docker configuration
IMAGE_NAME=jdownloader
CONTAINER_NAME=jdownloader-test
